# ===========================================
# AI CareerPilot - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# Database (PostgreSQL)
# For local dev with SQLite, use: file:./dev.db
DATABASE_URL="postgresql://user:password@localhost:5432/careerpilot"

# NextAuth.js
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI API (Optional - demo mode works without this)
# Supports any OpenAI-compatible API endpoint
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="" # Uncomment for custom endpoints (e.g., Azure, local LLMs)

# App Configuration
NEXT_PUBLIC_APP_NAME="AI CareerPilot"
NEXT_PUBLIC_DEMO_MODE="true"  # Set to "false" when OPENAI_API_KEY is configured
